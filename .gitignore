# ==============================================================================
# POLYGON BEATER — .gitignore
# ==============================================================================

# AI Modely a váhy
models/*
!models/.gitkeep
*.gguf
*.bin
*.pth
*.onnx

# Lokální konfigurace a privátní API klíče
config.json
!config.example.json

# Virtuální prostředí a balíčky
venv/
.venv/
env/

# Python cache a mezisoubory
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# RAG sémantická paměť a vektorová databáze (FAISS)
rag_storage/
*.faiss
*.pkl

# Historie relací a konverzací
sessions/*.json
!sessions/.gitkeep

# Zvukové nahrávky a dočasné audio soubory
*.wav
*.mp3
*.ogg
*.webm
debug_recording.wav

# Logy a dočasné soubory
*.log
*.bak
*.bak_*
.worktrees/

# PyInstaller a sestavení
build/
dist/
*.spec

# Systémové a editorové soubory
.DS_Store
Thumbs.db
.vscode/
.idea/
